{
  "name": "free-parking-ch",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=2048 next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:check": "NEXT_DIST_DIR=.next-build next build",
    "dev:webpack": "NODE_OPTIONS=--max-old-space-size=2048 next dev --webpack",
    "data": "node scripts/build-data.mjs",
    "test": "node --experimental-strip-types --no-warnings qa/rules.test.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "leaflet": "1.9.4",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
